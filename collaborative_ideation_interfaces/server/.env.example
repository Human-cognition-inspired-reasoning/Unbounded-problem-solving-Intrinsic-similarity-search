# Local development example. Production should keep SEED_DEMO_ACCOUNT=false,
# SESSION_COOKIE_SECURE=true, and set a stable random FLASK_SECRET_KEY through
# the service environment or a secret manager.
FLASK_SECRET_KEY=
SEED_DEMO_ACCOUNT=true
SESSION_COOKIE_SECURE=false

DEFAULT_CREDIT_LIMIT_USD=10.00
MAX_JSON_REQUEST_BYTES=1048576
MAX_CONCURRENT_MODEL_CALLS_PER_PARTICIPANT=3
MAX_GLOBAL_CONCURRENT_MODEL_CALLS=36
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
MAX_CONVERSATIONS_PER_PARTICIPANT=500
MAX_STORED_MESSAGE_CHARS_PER_PARTICIPANT=5000000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# File uploads: local for VM storage; off to disable.
# Without this setting, demo mode uses local and production uses off.
ATTACHMENT_STORAGE=local
# Linux VM: /usr/bin/soffice; leave empty to search PATH.
LIBREOFFICE_BIN=
# Linux: /usr/share/fonts/truetype/nanum/NanumGothic.ttf
ATTACHMENT_FONT_PATH=
ATTACHMENT_MAX_FILE_BYTES=10485760
ATTACHMENT_PARTICIPANT_BYTES=104857600
ATTACHMENT_CONVERSION_TIMEOUT=45
